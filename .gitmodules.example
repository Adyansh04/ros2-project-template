# Example .gitmodules file
# This file shows how git submodules are configured when you add external packages.
#
# To add a submodule, run:
#   git submodule add <repository-url> workspace/src/<package_name>
#
# Example entries (uncomment and modify as needed):

# [submodule "workspace/src/my_robot_description"]
#     path = workspace/src/my_robot_description
#     url = https://github.com/example/my_robot_description.git
#
# [submodule "workspace/src/ros2_controllers"]
#     path = workspace/src/ros2_controllers
#     url = https://github.com/ros-controls/ros2_controllers.git
#     branch = jazzy
#
# [submodule "workspace/src/navigation2"]
#     path = workspace/src/navigation2
#     url = https://github.com/ros-navigation/navigation2.git
#     branch = main
